generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id          Int      @id @default(autoincrement())
  fullName    String
  email       String   @unique
  password    String
  authProvider String  @default("password") @map("auth_provider")
  providerId  String?  @unique @map("provider_id")
  avatarUrl   String?  @map("avatar_url")
  oauthEnabled Boolean @default(false) @map("oauth_enabled")
  acceptedTermsAt DateTime? @map("accepted_terms_at")
  createdAt   DateTime @default(now())

  sessions      InterviewSession[]
  refreshTokens RefreshToken[]
  learningProgress LearningProgress[]
  quizAttempts     LearningQuizAttempt[]

  @@map("users")
}

model InterviewSession {
  id             String   @id @default(uuid())
  userId         Int
  problemName    String
  status         String   @default("active")
  stage          String   @default("greeting")
  coveredTopics  Json     @default("[]")          // ← Phase 3 (add now, use later)
  difficultyLevel String  @default("mid")          // ← Phase 3 (add now, use later)
  durationMinutes Int?                             // chosen interview length (15/30/45/60); null = untimed
  endedAt        DateTime?                         // set when the summary is generated; createdAt is the start anchor
  hintCount      Int      @default(0)              // Phase 2B: Real-time hints
  createdAt      DateTime @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages InterviewMessage[]
  summary  InterviewSummary?

  @@map("interview_sessions")
}

model InterviewMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("interview_messages")
}

model InterviewSummary {
  id           String   @id @default(uuid())
  sessionId    String   @unique
  strengths    String
  missedTopics String
  suggestions  String
  overallScore    Int?                          // 0-100 aggregate score
  dimensionScores Json?                          // { requirements|scalability|data_modeling|tradeoffs|communication: { score, comment } }
  topicCoverage   Json?                          // [{ topic, covered }]
  studyPlan       Json?                          // [{ topic, why }]
  idealAnswer     String?                        // concise reference design
  createdAt    DateTime @default(now())

  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("interview_summaries")
}

model KnowledgeChunk {
  id        Int      @id @default(autoincrement())
  topic     String   @db.VarChar(255)
  subtopic  String?  @db.VarChar(255)
  content   String
  embedding Unsupported("vector(768)")?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("knowledge_chunks")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     Int
  tokenHash  String    @unique
  deviceInfo String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model LearningTopic {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  slug        String   @unique
  order       Int      @default(0)
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons  LearningLesson[]
  progress LearningProgress[]

  @@map("learning_topics")
}

model LearningLesson {
  id               Int      @id @default(autoincrement())
  topicId          Int
  title            String
  description      String
  content          String   @db.Text
  order            Int      @default(0)
  youtubeVideoId   String?
  youtubeVideoTitle String?
  youtubeChannel   String?
  estimatedMinutes Int      @default(5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  topic    LearningTopic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions LearningQuizQuestion[]
  attempts  LearningQuizAttempt[]

  @@map("learning_lessons")
}

model LearningQuizQuestion {
  id          Int      @id @default(autoincrement())
  lessonId    Int
  question    String
  explanation String?  @db.Text
  order       Int      @default(0)

  lesson  LearningLesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options LearningQuizOption[]

  @@map("learning_quiz_questions")
}

model LearningQuizOption {
  id         Int      @id @default(autoincrement())
  questionId Int
  text       String
  isCorrect  Boolean  @default(false)

  question LearningQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("learning_quiz_options")
}

model LearningProgress {
  id           Int      @id @default(autoincrement())
  userId       Int
  topicId      Int
  completed    Boolean  @default(false)
  progress     Int      @default(0) // percentage 0-100
  lastLessonId Int?
  updatedAt    DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("learning_progress")
}

model LearningQuizAttempt {
  id             Int      @id @default(autoincrement())
  userId         Int
  lessonId       Int
  score          Int
  totalQuestions Int
  correctAnswers Int
  completedAt    DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson LearningLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("learning_quiz_attempts")
}

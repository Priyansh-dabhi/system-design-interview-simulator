{
  "expo": {
    "name": "AI Interview Simulator",
    "slug": "ai-interview-simulator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow System Design Interview Simulator to use speech recognition for voice input.",
        "NSMicrophoneUsageDescription": "Allow System Design Interview Simulator to use the microphone for voice input."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A5DDB",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.priyanshdabhi.interviewsimulator"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 144,
          "resizeMode": "contain",
          "backgroundColor": "#d8e1ea",
          "dark": {
            "image": "./assets/images/icon.png",
            "imageWidth": 144,
            "backgroundColor": "#d8e1ea"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow System Design Interview Simulator to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow System Design Interview Simulator to use speech recognition for voice input.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a76a192a-8685-4ece-95b1-bcbe61c2110a"
      }
    },
    "owner": "priyansh_dabhi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a76a192a-8685-4ece-95b1-bcbe61c2110a",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}

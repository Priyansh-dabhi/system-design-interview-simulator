# Dependencies — EAS runs `npm install` in the cloud
node_modules/

# Expo / bundler caches
.expo/
.expo-shared/
.metro-health-check*

# Local web/export output
dist/
web-build/

# Native generated directories — EAS runs `expo prebuild` in the cloud
# These are the biggest offenders (~4 GB locally)
android/
ios/

# Git history (not needed for builds)
.git/

# Logs and coverage
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
coverage/

# Temp / editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tmp
*.temp

# Local machine / generated files
*.tsbuildinfo

# Binary outputs that should never be uploaded to EAS
*.apk
*.aab
*.apks
*.hprof

# Local docs and scratch artifacts not needed for builds
docs/


# =============================================================
# EAS Build Ignore File
# Patterns use gitignore syntax. EAS CLI uses the `ignore` npm
# package which requires forward-slash paths (no backslashes).
# Using bare names (no slash) to match at ANY directory depth.
# =============================================================

# Dependencies (EAS installs fresh on cloud)
node_modules

# Expo & Metro caches
.expo
dist
web-build
.metro-health-check*

# Android build outputs & caches (the biggest offenders)
# These match any directory with these names at any depth:
android/app/build
android/app/.cxx
android/.gradle
android/.kotlin
android/build
android/local.properties

# Also match by bare name for safety
build
.gradle
.cxx
.kotlin

# Compiled binaries (by extension)
*.apk
*.aab
*.dex
*.class
*.hprof

# iOS
ios/build
ios/Pods
Pods

# IDE & editor
.idea
*.iml
.vscode

# Environment & secrets
.env*.local
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision
local.properties

# Logs & OS metadata
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store

# VCS & docs
.git
docs
